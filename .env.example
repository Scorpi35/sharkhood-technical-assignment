# Copy to .env for local (non-docker) runs. Real env vars take precedence.
# The app validates all of these at startup and exits(1) on any invalid value.

# development | test | production   (development = pretty logs)
NODE_ENV=development
PORT=3000

# Required
MONGO_URI=mongodb://localhost:27017
RAW_DB_NAME=provider_raw
TARGET_DB_NAME=provider_domain

# Required
REDIS_URL=redis://localhost:6379

# api | worker | all
APP_ROLE=all
# integer >= 1
WORKER_CONCURRENCY=4
# integer >= 1
JOB_ATTEMPTS=5
JOB_BACKOFF_MS=1000
# Stall recovery for a killed worker's jobs (worst case ~ lock duration + stalled interval)
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=15000
WORKER_MAX_STALLED_COUNT=2

BATCH_SIZE_DEFAULT=200
# Menu documents are ~27 KB each, so they get a smaller batch.
BATCH_SIZE_MENUS=25
ERROR_SAMPLE_SIZE=20

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
